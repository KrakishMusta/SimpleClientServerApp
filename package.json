{
    "name": "simple-client-server-app",
    "private": true,
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "dev:backend": "cd backend && yarn start:dev",
        "dev:frontend": "cd frontend && yarn dev",
        "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"yarn dev:backend\" \"yarn dev:frontend\"",
        "install:all": "yarn install",
        "clean": "rm -rf node_modules backend/node_modules frontend/node_modules"
    },
    "devDependencies": {
        "concurrently": "^8.0.0"
    }
}
